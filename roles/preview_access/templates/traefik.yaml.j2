# Managed by Ansible (preview-infra). Local edits are overwritten.
#
# The middleware Coolify's proxy puts in front of every router of its http
# and https entrypoints (--entrypoints.*.http.middlewares, set by the
# playbook in Coolify's proxy configuration). preview-access refuses requests
# to {{ preview_access_zones | join(', ') }} without a valid Cloudflare Access
# token and lets every other host through.
http:
  middlewares:
    preview-access:
      forwardAuth:
        address: "http://preview-access:{{ preview_access_port }}/"
        # The host it checks is the request's own, never an X-Forwarded-Host
        # sent by the client.
        trustForwardHeader: false
  # A route that always exists on each protected zone, for the playbook's
  # check that Traefik refuses it without a token.
  routers:
    preview-access-probe:
      entryPoints: [http]
      rule: "{% for zone in preview_access_zones %}{{ ' || ' if not loop.first }}Host(`{{ preview_access_probe }}.{{ zone }}`){% endfor %}"
      service: noop@internal
