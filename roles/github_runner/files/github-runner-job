#!/usr/bin/env python3
# Managed by Ansible (preview-infra). Runs one GitHub Actions job for the runner
# instance named on the command line, then exits; systemd starts it again for
# the next job (github-runner@.service).
#
#   1. Waits until the disk has room, and empties the tool cache past its size.
#   2. Refuses to go on when the repository is not private, or when the
#      organization's runner group allows public repositories. Checked before
#      every registration, so a repository made public later is refused too.
#   3. Registers a just-in-time runner, which takes a single job.
#   4. Runs it with docker compose and removes the containers, their volumes
#      and the registration when the job ends or the service stops.
#
# Settings: /etc/github-runner/config.json (written by the playbook) and the
# token in /etc/github-runner/token.
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request

CONFIG_DIR = "/etc/github-runner"
# systemd does not restart the unit on this code (RestartPreventExitStatus).
EXIT_REFUSED = 78


class Refused(Exception):
    pass


def log(message):
    print(message, flush=True)


def api(config, token, method, path, body=None):
    request = urllib.request.Request(
        config["api"] + path,
        method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "Content-Type": "application/json",
            "User-Agent": "preview-infra-github-runner",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        data = response.read()
    return json.loads(data) if data else None


def check_private(config, token, target):
    kind, name = target.split("/", 1)
    try:
        if kind == "repos":
            repo = api(config, token, "GET", f"/repos/{name}")
            if not repo.get("private") or repo.get("visibility", "private") != "private":
                raise Refused(f"{name} is not private; this runner only serves private repositories")
        else:
            group_id = config["runner_group_id"]
            group = api(config, token, "GET", f"/orgs/{name}/actions/runner-groups/{group_id}")
            if group.get("allows_public_repositories", True):
                raise Refused(f"runner group {group_id} of {name} allows public repositories")
    except urllib.error.HTTPError as error:
        if error.code in (401, 404):
            raise Refused(f"{name}: HTTP {error.code}; the token is rejected or cannot see it")
        raise


def free_gb(path):
    return shutil.disk_usage(path).free / 1e9


def size_gb(path):
    total = 0
    for root, _, files in os.walk(path):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_size
            except OSError:
                pass
    return total / 1e9


def fresh_dir(path, uid, empty):
    if empty and os.path.exists(path):
        shutil.rmtree(path)
    os.makedirs(path, exist_ok=True)
    os.chown(path, uid, -1)


def wait_for_disk(config):
    docker_root = subprocess.run(
        ["docker", "info", "--format", "{{.DockerRootDir}}"],
        capture_output=True, text=True, check=False,
    ).stdout.strip() or "/var/lib/docker"
    wanted = config["min_free_disk_gb"]
    while (free := min(free_gb(docker_root), free_gb(config["data_dir"]))) < wanted:
        log(f"Only {free:.1f} GB free, waiting for {wanted} GB before taking a job")
        time.sleep(300)


def main():
    instance = sys.argv[1]
    with open(f"{CONFIG_DIR}/config.json") as f:
        config = json.load(f)
    target = config["instances"].get(instance)
    if target is None:
        raise Refused(f"{instance} is not in {CONFIG_DIR}/config.json")
    with open(f"{CONFIG_DIR}/token") as f:
        token = f.read().strip()
    check_private(config, token, target)

    wait_for_disk(config)
    base = os.path.join(config["data_dir"], instance)
    work, tool_cache = os.path.join(base, "work"), os.path.join(base, "tool-cache")
    os.makedirs(base, exist_ok=True)
    fresh_dir(work, config["uid"], empty=True)
    too_big = os.path.exists(tool_cache) and size_gb(tool_cache) > config["tool_cache_max_gb"]
    if too_big:
        log(f"Emptying the tool cache, over {config['tool_cache_max_gb']} GB")
    fresh_dir(tool_cache, config["uid"], empty=too_big)

    project = "ghr-" + re.sub(r"[^a-z0-9_-]", "_", instance.lower())
    compose = ["docker", "compose", "--project-name", project, "--file", f"{CONFIG_DIR}/compose.yml"]
    env = dict(os.environ, RUNNER_WORK=work, RUNNER_TOOL_CACHE_DIR=tool_cache)
    down = compose + ["down", "--volumes", "--remove-orphans", "--timeout", "10"]
    # Leftovers of a job cut short (crash, power loss).
    subprocess.run(down, env=env, check=False)

    registration = api(config, token, "POST", f"/{target}/actions/runners/generate-jitconfig", {
        "name": f"{config['name_prefix']}-{instance}-{int(time.time())}",
        "runner_group_id": config["runner_group_id"] if target.startswith("orgs/") else 1,
        "labels": config["labels"],
        "work_folder": "_work",
    })
    runner_id = registration["runner"]["id"]
    log(f"Registered runner {registration['runner']['name']} for {target}")

    try:
        job = subprocess.run(
            compose + ["up", "--exit-code-from", "runner", "--quiet-pull"],
            env=dict(env, ACTIONS_RUNNER_INPUT_JITCONFIG=registration["encoded_jit_config"]),
            check=False,
        )
        log(f"Runner exited with {job.returncode}")
        return job.returncode
    finally:
        subprocess.run(down, env=env, check=False)
        # GitHub removes an ephemeral runner after its job; this covers a
        # runner stopped before it got one.
        try:
            api(config, token, "DELETE", f"/{target}/actions/runners/{runner_id}")
        except urllib.error.HTTPError as error:
            if error.code != 404:
                log(f"Could not remove runner {runner_id}: HTTP {error.code}")
        except OSError as error:
            log(f"Could not remove runner {runner_id}: {error}")


def stop(signum, frame):
    raise SystemExit(128 + signum)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, stop)
    try:
        code = main()
    except Refused as error:
        log(f"Refused: {error}")
        sys.exit(EXIT_REFUSED)
    except (urllib.error.URLError, OSError, KeyError, ValueError) as error:
        log(f"Failed: {error}; trying again in a minute")
        time.sleep(60)
        sys.exit(1)
    if code != 0:
        # Do not spin on a broken image or daemon.
        time.sleep(30)
    sys.exit(code)
