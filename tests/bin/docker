#!/usr/bin/env python3
# Stands in for `docker exec coolify php artisan tinker` in tests/coolify_env.py:
# answers the session the coolify_apps role opens and closes, and `docker login`,
# and logs each call (stdin, where the registry token goes, is not logged).
import json
import os
import sys

command = " ".join(sys.argv[1:])
with open(os.environ["FAKE_DOCKER_LOG"], "a") as log:
    log.write(command.replace("\n", " ") + "\n")

if sys.argv[1:2] == ["login"]:
    sys.stdin.read()
    print("Login Succeeded")
elif "createToken" in command:
    env_token = "fake-env-token" if "read:sensitive" in command else None
    was = os.environ.get("FAKE_API_WAS_ENABLED", "1") == "1"
    print(json.dumps({"token": "fake-token", "env_token": env_token, "api_was_enabled": was}))
else:
    print("closed")
