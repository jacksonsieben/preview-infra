#!/usr/bin/env python3
# Stands in for `docker exec coolify php artisan tinker` in tests/coolify_env.py:
# answers the session the coolify_apps role opens and closes, and logs each call.
import json
import os
import sys

command = " ".join(sys.argv[1:])
with open(os.environ["FAKE_DOCKER_LOG"], "a") as log:
    log.write(command.replace("\n", " ") + "\n")

if "createToken" in command:
    env_token = "fake-env-token" if "read:sensitive" in command else None
    print(json.dumps({"token": "fake-token", "env_token": env_token, "api_was_enabled": True}))
else:
    print("closed")
